### where the zl1's orientation value comes from -- host-side, read-only, device NOT involved
### 2026-09-23 (the phone was in Qualcomm EDL: 05c6:9008)
###
### source: the UT rootfs image, mounted read-only (loop,ro,noload), never written:
###   /mnt/data/ubports-rootfs/24.04-2.x/rootfs-24.04-2.x-arm64-android9plus-zl1-host-4g.img
###   /mnt/zl1-rootfs

$ sudo mount -o loop,ro,noload /mnt/data/ubports-rootfs/.../rootfs-...-zl1-host-4g.img /mnt/zl1-rootfs

########## 1. the live configuration (read-only image; /etc/writable is the only rw part)
$ ls /mnt/zl1-rootfs/etc/sensorfw/sensord.conf.d/
   total 12
   -rw-r--r-- 1 root root  100 Apr 29  2025 10-sensord-default.conf
   -rw-r--r-- 1 root root 2041 Apr 29  2025 20-sensors-default.conf
   -rw-r--r-- 1 root root  504 May 11 06:54 30-hidl.conf

$ cat /mnt/zl1-rootfs/etc/sensorfw/sensord.conf.d/30-hidl.conf
   [plugins]
   accelerometeradaptor = hidlaccelerometeradaptor
   alsadaptor = hidlalsadaptor
   proximityadaptor = hidlproximityadaptor
   magnetometeradaptor = hidlmagnetometeradaptor
   gyroscopeadaptor = hidlgyroscopeadaptor
   orientationadaptor = hidlorientationadaptor
   stepcounteradaptor = hidlstepcounteradaptor
   pressureadaptor = hidlpressureadaptor
   
   [magnetometer]
   scale_coefficient = 1
   transformation_matrix = "-1,0,0,0,1,0,0,0,1"
   needs_calibration = 0
   
   [accelerometer]
   transformation_matrix = "1,0,0,0,1,0,0,0,1"

### the availability file's whole point, from /mnt/zl1-rootfs/etc/sensorfw/sensord.conf.d/20-sensors-default.conf:
   11:accelerometersensor=Feature_AccelerationSensor
   12:alssensor=Feature_LightSensor
   13:compasssensor=Feature_CompassSensor
   14:gyroscopesensor=Feature_GyroSensor
   15:orientationsensor=Feature_GyroSensor|Feature_AccelerationSensor
   16:proximitysensor=Feature_ProximitySensor
   24:lidsensor=False
   29:tapsensor=False
   30:temperaturesensor=False
   34:humiditysensor=False
   35:stepcountersensor=False
   42:magnetometersensor=True
   43:pressuresensor=True
   44:rotationsensor=True
   50:wakeupsensor=False

### (note: ALS and proximity also use the =Feature_ form, and both demonstrably work on this
###  port -- so the Feature_ form cannot be what makes a sensor unavailable. See section 4.)

