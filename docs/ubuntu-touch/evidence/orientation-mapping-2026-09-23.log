-- 2. THE THREE ENUMS, AND THE FOUR VALUES BETWEEN THEM ---------------------------
# The whole chain uses three different enums with three different numberings. Every
# claim below is quoted from source, and where the flattened numbering matters it is
# re-checked against the installed binary (section 3-5).
#
# (a) sensorfw  -- sensors/orientationsensor + filters/orientationinterpreter
#     ubports/sensorfw, branch xenial_-_android9, datatypes/posedata.h:

    /**
     * Device orientation.
     */
    enum Orientation
    {
        Undefined = 0, /**< Orientation is unknown. */
        LeftUp,        /**< Device left side is up */
        RightUp,       /**< Device right side is up */
        BottomUp,      /**< Device bottom is up */
        BottomDown,    /**< Device bottom is down */
        FaceDown,      /**< Device face is down */
        FaceUp         /**< Device face is up */
    };

    PoseData::Orientation orientation_; /**< Device Orientation */
#
# (b) QtSensors -- Qt's own QOrientationReading::Orientation
#     qt/qtsensors, branch 5.15, src/sensors/qorientationsensor.h:

    DECLARE_READING(QOrientationReading)
public:
    enum Orientation {
        Undefined = 0,
        TopUp,
        TopDown,
        LeftUp,
        RightUp,
        FaceUp,
        FaceDown
    };

    Orientation orientation() const;
#
# (c) Qt itself -- Qt::ScreenOrientation (what qtmir stores). From the log in docs 70,
#     the value names qtmir logs are these, and the numbers are Qt's:
#       Qt::PrimaryOrientation = 0            Qt::PortraitOrientation = 1
#       Qt::LandscapeOrientation = 2          Qt::InvertedPortraitOrientation = 4
#       Qt::InvertedLandscapeOrientation = 8
#
