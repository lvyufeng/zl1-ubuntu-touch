$ cat /mnt/zl1-rootfs/var/lib/dpkg/info/libsensorfw-qt5-hidl.list | grep sensord-qt5
   libhidlaccelerometeradaptor-qt5.so
   libhidlalsadaptor-qt5.so
   libhidlgeorotationadaptor-qt5.so
   libhidlgyroscopeadaptor-qt5.so
   libhidlmagnetometeradaptor-qt5.so
   libhidlorientationadaptor-qt5.so
   libhidlpressureadaptor-qt5.so
   libhidlproximityadaptor-qt5.so
   libhidlrotationadaptor-qt5.so
   libhidlstepcounteradaptor-qt5.so
   libhidlwakeupadaptor-qt5.so
/usr/lib/aarch64-linux-gnu/sensord-qt5

$ grep -A9 '^\[plugins\]' /mnt/zl1-rootfs/etc/sensorfw/sensord.conf.d/30-hidl.conf
   [plugins]
   accelerometeradaptor = hidlaccelerometeradaptor
   alsadaptor = hidlalsadaptor
   proximityadaptor = hidlproximityadaptor
   magnetometeradaptor = hidlmagnetometeradaptor
   gyroscopeadaptor = hidlgyroscopeadaptor
   orientationadaptor = hidlorientationadaptor
