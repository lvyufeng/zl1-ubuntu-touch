#!/usr/bin/python3
import os, socket, threading, time, subprocess
LOG = "/run/zl1-debug-net.log"
PORTS = (8081, 8080)
def read_file(path, limit=65536):
    try:
        with open(path, "rb") as f:
            data = f.read(limit)
        return data.decode("utf-8", "replace")
    except Exception as e:
        return "<cannot read %s: %s>\n" % (path, e)
def read_tail(path, limit=131072):
    try:
        with open(path, "rb") as f:
            try:
                f.seek(0, os.SEEK_END)
                size = f.tell()
                f.seek(max(0, size - limit), os.SEEK_SET)
            except Exception:
                pass
            data = f.read(limit)
        prefix = ""
        if len(data) >= limit:
            prefix = "<tail last %d bytes of %s>\n" % (limit, path)
        return prefix + data.decode("utf-8", "replace")
    except Exception as e:
        return "<cannot tail %s: %s>\n" % (path, e)
def list_dir(path, limit=200):
    try:
        names = sorted(os.listdir(path))[:limit]
        return "\n".join(names) + ("\n" if names else "")
    except Exception as e:
        return "<cannot list %s: %s>\n" % (path, e)
def read_cmdline(pid):
    try:
        data = open("/proc/%s/cmdline" % pid, "rb").read(4096)
        data = data.replace(bytes([0]), b" ").strip()
        return data.decode("utf-8", "replace")
    except Exception:
        return ""
def proc_summary():
    rows = []
    try:
        pids = sorted([x for x in os.listdir("/proc") if x.isdigit()], key=lambda x: int(x))
    except Exception as e:
        return "<cannot list /proc: %s>\n" % e
    keywords = ("init", "systemd", "lxc", "android", "zygote", "surface", "hwservice", "qsee", "servicemanager", "usb", "python", "getprop", "setprop", "logd", "ueventd", "vold")
    for pid in pids:
        try:
            status = read_file("/proc/%s/status" % pid, 8192)
            vals = {}
            for line in status.splitlines():
                if line.startswith(("Name:", "State:", "PPid:")):
                    k, v = line.split(":", 1)
                    vals[k] = v.strip()
            cmd = read_cmdline(pid)
            hay = (vals.get("Name", "") + " " + cmd).lower()
            if pid == "1" or any(k in hay for k in keywords):
                rows.append("%s\tppid=%s\tstate=%s\tname=%s\tcmd=%s" % (pid, vals.get("PPid", "?"), vals.get("State", "?"), vals.get("Name", "?"), cmd))
        except Exception:
            continue
    return "\n".join(rows[:260]) + ("\n" if rows else "")
def net_class_summary():
    out = []
    try:
        ifaces = sorted(os.listdir("/sys/class/net"))
    except Exception:
        ifaces = []
    for ifname in ifaces:
        base = "/sys/class/net/%s" % ifname
        vals = []
        for key in ("address", "operstate", "carrier", "ifindex"):
            try:
                vals.append("%s=%s" % (key, open("%s/%s" % (base, key)).read().strip()))
            except Exception:
                pass
        out.append(ifname + " " + " ".join(vals))
    return "\n".join(out) + ("\n" if out else "")
def read_one(path):
    try:
        return open(path, "rb").read(4096).decode("utf-8", "replace").strip()
    except Exception as e:
        return "<%s>" % e
def named_paths_summary(title, paths):
    out = [title]
    for path in paths:
        out.append("%s=%s" % (path, read_one(path)))
    return "\n".join(out) + "\n"
def android_usb_summary():
    base = "/sys/class/android_usb/android0"
    rels = ("state", "functions", "enable", "idVendor", "idProduct", "iManufacturer", "iProduct", "iSerial",
            "f_rndis/ethaddr", "f_rndis/vendorID", "f_rndis/manufacturer", "f_rndis/wceis")
    return named_paths_summary("android_usb", [base + "/" + r for r in rels])
def configfs_usb_summary():
    out = []
    roots = ("/sys/kernel/config/usb_gadget", "/config/usb_gadget")
    for root in roots:
        try:
            gadgets = sorted(os.listdir(root))
        except Exception as e:
            out.append("%s=<cannot list: %s>" % (root, e))
            continue
        out.append("%s gadgets=%s" % (root, ",".join(gadgets)))
        for g in gadgets[:4]:
            gb = root + "/" + g
            for rel in ("UDC", "idVendor", "idProduct", "strings/0x409/serialnumber", "strings/0x409/manufacturer", "strings/0x409/product"):
                out.append("%s/%s=%s" % (gb, rel, read_one(gb + "/" + rel)))
    return "\n".join(out) + ("\n" if out else "")
def systemd_runtime_summary():
    out = []
    for path in ("/run/systemd/system/usb-moded.service", "/run/systemd/system/zl1-debug-net.service",
                 "/run/systemd/system/sysinit.target.wants/zl1-debug-net.service",
                 "/run/systemd/system/multi-user.target.wants/zl1-debug-net.service",
                 "/etc/systemd/system/zl1-debug-net.service",
                 "/etc/systemd/system/usb-moded.service", "/lib/systemd/system/usb-moded.service",
                 "/usr/lib/systemd/system/usb-moded.service"):
        try:
            if os.path.islink(path):
                out.append("%s -> %s" % (path, os.readlink(path)))
            elif os.path.exists(path):
                out.append("%s exists" % path)
            else:
                out.append("%s missing" % path)
        except Exception as e:
            out.append("%s error=%s" % (path, e))
    try:
        names = sorted(n for n in os.listdir("/run/systemd/system") if "usb" in n.lower() or "zl1" in n.lower())
        out.append("/run/systemd/system filtered=" + ",".join(names))
    except Exception as e:
        out.append("/run/systemd/system list error=%s" % e)
    return "\n".join(out) + "\n"
def command_summary(cmd, limit=65536, timeout=1.5):
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
        data = p.stdout[:limit].decode("utf-8", "replace")
        return "$ %s\nrc=%s\n%s" % (" ".join(cmd), p.returncode, data)
    except Exception as e:
        return "$ %s\n<%s: %s>\n" % (" ".join(cmd), type(e).__name__, e)
def append_log(msg):
    line = "zl1-python-status-v63: %s\n" % msg
    try:
        os.makedirs("/run", exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line)
    except Exception:
        pass
    try:
        with open("/dev/kmsg", "w") as k:
            k.write(line)
    except Exception:
        pass
def status_text():
    parts = [
        "zl1 python status endpoint v63\n",
        time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + "\n",
        "--- cmdline ---\n", read_file("/proc/cmdline"),
        "--- uptime ---\n", read_file("/proc/uptime"),
        "--- proc 1 status ---\n", read_file("/proc/1/status", 16384),
        "--- proc 1 cmdline ---\n", read_cmdline("1") + "\n",
        "--- selected processes ---\n", proc_summary(),
        "--- sys class net ---\n", net_class_summary(),
        "--- android usb summary ---\n", android_usb_summary(),
        "--- configfs usb summary ---\n", configfs_usb_summary(),
        "--- systemd runtime usb masks ---\n", systemd_runtime_summary(),
        "--- zl1 debug net lock ---\n", named_paths_summary("debug_net_lock", ["/run/zl1-debug-net.lock/pid", "/run/zl1-debug-net.lock/ppid", "/run/zl1-debug-net.lock/start_uptime", "/run/zl1-debug-net.lock/ppid_comm", "/run/zl1-debug-net.lock/ppid_cmdline", "/run/zl1-debug-net.lock/pid1_comm", "/run/zl1-debug-net.lock/pid1_cmdline"]),
        "--- zl1 debug net systemd show ---\n", command_summary(["systemctl", "show", "zl1-debug-net.service", "-p", "MainPID", "-p", "NRestarts", "-p", "Result", "-p", "ExecMainStatus", "-p", "ExecMainCode", "-p", "ActiveState", "-p", "SubState"], 65536, 1.5),
        "--- zl1 debug net systemd status ---\n", command_summary(["systemctl", "status", "--no-pager", "-l", "zl1-debug-net.service"], 65536, 1.5),
        "--- zl1 debug net journal ---\n", command_summary(["journalctl", "-b", "-u", "zl1-debug-net.service", "--no-pager", "-n", "80"], 65536, 1.5),
        "--- usb android state ---\n", read_file("/sys/class/android_usb/android0/state", 4096),
        "--- usb android functions ---\n", read_file("/sys/class/android_usb/android0/functions", 4096),
        "--- usb android enable ---\n", read_file("/sys/class/android_usb/android0/enable", 4096),
        "--- proc net dev ---\n", read_file("/proc/net/dev"),
        "--- proc net route ---\n", read_file("/proc/net/route"),
        "--- proc net tcp ---\n", read_file("/proc/net/tcp"),
        "--- proc mounts ---\n", read_file("/proc/mounts", 65536),
        "--- dev socket listing ---\n", list_dir("/dev/socket", 200),
        "--- dev properties listing ---\n", list_dir("/dev/__properties__", 240),
        "--- run zl1 files ---\n", list_dir("/run", 400),
        "--- debug net log tail ---\n", read_tail(LOG, 65536),
        "--- v63 monitor log tail ---\n", read_tail("/userdata/zl1-v63-monitor.log", 131072),
        "--- v63 monitor run log tail ---\n", read_tail("/run/zl1-v63-monitor.log", 131072),
        "--- debug init log ---\n", read_file("/run/zl1-debug-init.log", 65536),
        "--- lxc ready log ---\n", read_tail("/run/zl1-lxc-ready.log", 65536),
        "--- prop wrapper log ---\n", read_tail("/run/zl1-prop-wrapper.log", 65536),
        "--- hwservicemanager patch log ---\n", read_tail("/run/zl1-hwservicemanager-patch.log", 65536),
        "--- qseecomd patch log ---\n", read_tail("/run/zl1-qseecomd-patch.log", 65536),
        "--- libc property socket patch log ---\n", read_tail("/run/zl1-libc-prop-socket-patch.log", 65536),
        "--- rc seclabel patch log ---\n", read_tail("/run/zl1-rc-seclabel.log", 65536),
        "--- usb hal stub log ---\n", read_tail("/run/zl1-usb-hal-stub.log", 65536),
        "--- usb hal rc patch log ---\n", read_tail("/run/zl1-usb-hal-rc-patch.log", 65536),
        "--- v63 usb fakebind log ---\n", read_tail("/run/zl1-v63-usb-fakebind.log", 65536),
        "--- v63 fake android_usb tree ---\n", named_paths_summary("v63_fake_android_usb", ["/run/zl1-v63-fake-sys/class/android_usb/android0/" + r for r in ("enable", "functions", "state", "idVendor", "idProduct", "iProduct", "iSerial", "f_rndis/ethaddr", "f_rndis/wceis")]),
        "--- lxc config runtime /run ---\n", read_file("/run/zl1-lxc-config-noble", 65536),
        "--- lxc config active ---\n", read_file("/var/lib/lxc/android/config", 65536),
        "--- lxc android log tail ---\n", read_tail("/var/log/lxc/android.log", 131072),
        "--- pstore listing ---\n", list_dir("/sys/fs/pstore", 200),
        "--- status done ---\n",
    ]
    return "".join(parts)
def drain_request(conn):
    conn.settimeout(0.4)
    data = b""
    end = time.time() + 1.0
    while time.time() < end and len(data) < 4096:
        try:
            chunk = conn.recv(1024)
        except socket.timeout:
            break
        except Exception:
            break
        if not chunk:
            break
        data += chunk
        if b"\r\n\r\n" in data or b"\n\n" in data:
            break
    return data
def handle(conn, addr):
    try:
        append_log("client %s accepted" % (addr,))
        drain_request(conn)
        body = status_text().encode("utf-8", "replace")
        header = ("HTTP/1.0 200 OK\r\n"
                  "Content-Type: text/plain; charset=utf-8\r\n"
                  "Content-Length: %d\r\n"
                  "Connection: close\r\n\r\n" % len(body)).encode("ascii")
        conn.settimeout(8.0)
        conn.sendall(header)
        conn.sendall(body)
        try:
            conn.shutdown(socket.SHUT_WR)
        except Exception:
            pass
        time.sleep(0.1)
        append_log("client %s sent %d bytes" % (addr, len(body)))
    except Exception as e:
        append_log("client %s error %s: %s" % (addr, type(e).__name__, e))
    finally:
        try:
            conn.close()
        except Exception:
            pass
def serve(port):
    while True:
        s = None
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(("0.0.0.0", port))
            s.listen(8)
            append_log("listening on 0.0.0.0:%d" % port)
            while True:
                conn, addr = s.accept()
                threading.Thread(target=handle, args=(conn, addr), daemon=True).start()
        except Exception as e:
            append_log("server port %d restart after %s: %s" % (port, type(e).__name__, e))
            try:
                if s:
                    s.close()
            except Exception:
                pass
            time.sleep(1)
for port in PORTS:
    threading.Thread(target=serve, args=(port,), daemon=True).start()
while True:
    time.sleep(60)
EOF_ZL1_STATUS_SERVER
chmod 0755 "$ROOT/usr/local/sbin/zl1-status-server.py" 2>/dev/null || true
cat > "$ROOT/usr/local/sbin/zl1-debug-net.sh" <<'EOF_ZL1_DEBUG_NET'
#!/bin/sh
PATH=/usr/local/sbin:/sbin:/usr/sbin:/bin:/usr/bin:/tmp
BB=/usr/local/sbin/zl1-busybox
[ -x "$BB" ] || BB=/tmp/busybox
LOG=/run/zl1-debug-net.log
ANDROID_USB=/sys/class/android_usb/android0
mkdir -p /run 2>/dev/null || true
log() {
    msg="zl1-debug-net-v63: $*"
    echo "$msg" >> "$LOG" 2>/dev/null || true
    echo "$msg" > /dev/kmsg 2>/dev/null || true
}
uptime_now() { cat /proc/uptime 2>/dev/null | { read a b; printf '%s' "$a"; }; }
proc_comm() { [ -r "/proc/$1/comm" ] && tr -d '\r\n' < "/proc/$1/comm" 2>/dev/null || printf '?'; }
proc_cmdline() { [ -r "/proc/$1/cmdline" ] && tr '\000' ' ' < "/proc/$1/cmdline" 2>/dev/null | tr -d '\r\n' || printf '?'; }
LOCKDIR=/run/zl1-debug-net.lock
LOCKPID="$LOCKDIR/pid"
record_primary_lock() {
    echo "$$" > "$LOCKPID" 2>/dev/null || true
    echo "$PPID" > "$LOCKDIR/ppid" 2>/dev/null || true
    echo "$(uptime_now)" > "$LOCKDIR/start_uptime" 2>/dev/null || true
    proc_comm "$PPID" > "$LOCKDIR/ppid_comm" 2>/dev/null || true
    proc_cmdline "$PPID" > "$LOCKDIR/ppid_cmdline" 2>/dev/null || true
    proc_comm 1 > "$LOCKDIR/pid1_comm" 2>/dev/null || true
    proc_cmdline 1 > "$LOCKDIR/pid1_cmdline" 2>/dev/null || true
}
cleanup_primary() {
    rc=$?
    trap - EXIT HUP INT TERM
    log "keeper exit v63 pid=$$ rc=$rc uptime=$(uptime_now)"
    rm -rf "$LOCKDIR" 2>/dev/null || true
    exit "$rc"
}
if mkdir "$LOCKDIR" 2>/dev/null; then
    record_primary_lock
    log "keeper primary start v63 pid=$$ ppid=$PPID pcomm=$(proc_comm "$PPID") pcmd=$(proc_cmdline "$PPID") pid1=$(proc_comm 1)|$(proc_cmdline 1) uptime=$(uptime_now)"
    trap cleanup_primary EXIT HUP INT TERM
else
    primary="$(cat "$LOCKPID" 2>/dev/null || true)"
    if [ -n "$primary" ] && kill -0 "$primary" 2>/dev/null; then
        log "keeper duplicate exit v63 pid=$$ ppid=$PPID primary=$primary pcomm=$(proc_comm "$PPID") pcmd=$(proc_cmdline "$PPID") pid1=$(proc_comm 1)|$(proc_cmdline 1) uptime=$(uptime_now)"
        exit 0
    fi
    log "keeper stale lock v63 pid=$$ ppid=$PPID old_primary=$primary uptime=$(uptime_now); replacing"
    rm -rf "$LOCKDIR" 2>/dev/null || true
    if mkdir "$LOCKDIR" 2>/dev/null; then
        record_primary_lock
        log "keeper primary start after stale lock v63 pid=$$ ppid=$PPID pcomm=$(proc_comm "$PPID") pcmd=$(proc_cmdline "$PPID") pid1=$(proc_comm 1)|$(proc_cmdline 1) uptime=$(uptime_now)"
        trap cleanup_primary EXIT HUP INT TERM
    else
        log "keeper duplicate exit v63 pid=$$ ppid=$PPID reason=lock-reacquire-failed uptime=$(uptime_now)"
        exit 0
    fi
fi
read_one() { cat "$1" 2>/dev/null | tr -d '\r\n'; }
write_file() { [ -e "$1" ] && echo -n "$2" > "$1" 2>/dev/null || true; }
ensure_ttys() {
    mkdir -p /dev/pts 2>/dev/null || true
    grep -q ' /dev/pts ' /proc/mounts 2>/dev/null || mount -t devpts devpts /dev/pts 2>/dev/null || true
    [ -e /dev/ptmx ] || mknod -m 666 /dev/ptmx c 5 2 2>/dev/null || true
    chmod 666 /dev/ptmx 2>/dev/null || true
}
have_listener() {
    port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | grep -Eq "[.:]$port[[:space:]]" && return 0
    fi
    if command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | grep -Eq "[.:]$port[[:space:]]" && return 0
    fi
    hexport="$(printf '%04X' "$port" 2>/dev/null || true)"
    if [ -n "$hexport" ] && awk -v p=":$hexport" 'NR>1 && index($2,p) && $4=="0A" {found=1} END{exit found?0:1}' /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
        return 0
    fi
    return 1
}
debug_shell_enabled() {
    case " $(cat /proc/cmdline 2>/dev/null) " in
        *" zl1_debug_shell=1 "*) return 0 ;;
    esac
    return 1
}
process_alive() {
    pidfile="$1"
    [ -s "$pidfile" ] || return 1
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}
write_runtime_systemd_units() {
    mkdir -p /run/systemd/system/sysinit.target.wants /run/systemd/system/multi-user.target.wants 2>/dev/null || true
    ln -sfn /dev/null /run/systemd/system/usb-moded.service 2>/dev/null || true
    cat > /run/systemd/system/zl1-debug-net.service <<'EOF_ZL1_RUNTIME_UNIT'
[Unit]
Description=zl1 V63 single-keeper USB diagnostic network keeper
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Before=sysinit.target basic.target usb-moded.service
Conflicts=usb-moded.service
[Service]
Type=simple
ExecStart=/usr/local/sbin/zl1-debug-net.sh
Restart=on-failure
RestartSec=1
[Install]
WantedBy=sysinit.target multi-user.target
EOF_ZL1_RUNTIME_UNIT
    ln -sf ../zl1-debug-net.service /run/systemd/system/sysinit.target.wants/zl1-debug-net.service 2>/dev/null || true
    ln -sf ../zl1-debug-net.service /run/systemd/system/multi-user.target.wants/zl1-debug-net.service 2>/dev/null || true
}
maybe_systemctl_mask_usb() {
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl mask --runtime usb-moded.service >/dev/null 2>&1 || true
        systemctl stop usb-moded.service >/dev/null 2>&1 || true
    fi
}
kill_usb_managers() {
    killed=0
    for d in /proc/[0-9]*; do
        [ -d "$d" ] || continue
        pid="${d##*/}"
        [ "$pid" = "$$" ] && continue
        cmd="$(tr '\000' ' ' < "$d/cmdline" 2>/dev/null || true)"
        name="$(cat "$d/comm" 2>/dev/null || true)"
        case "$cmd $name" in
            *usb_moded*|*usb-moded*)
                log "killing USB gadget manager pid=$pid name=$name cmd=$cmd"
                kill "$pid" 2>/dev/null || true
                killed=1
                ;;
            *'/run/usb-moded/udhcpd.conf'*)
                log "killing usb-moded udhcpd pid=$pid name=$name cmd=$cmd"
                kill "$pid" 2>/dev/null || true
                killed=1
                ;;
        esac
    done
    [ "$killed" = 1 ] && return 0
    return 1
}
start_python_status() {
    PY=""
    for cand in /usr/bin/python3 /bin/python3 /usr/local/bin/python3; do
        [ -x "$cand" ] && { PY="$cand"; break; }
    done
    [ -n "$PY" ] || { log "no rootfs python3 for status server"; return 1; }
    if process_alive /run/zl1-pystatus.pid; then
        return 0
    fi
    "$PY" /usr/local/sbin/zl1-status-server.py >>"$LOG" 2>&1 &
    echo "$!" > /run/zl1-pystatus.pid 2>/dev/null || true
    log "started python3 status server pid=$! ($PY) on 0.0.0.0:8081/8080"
    return 0
}
write_http_status() {
    mkdir -p /run/zl1-http 2>/dev/null || true
    {
        echo "zl1 debug status v63"
        date 2>/dev/null || true
        echo "--- cmdline ---"
